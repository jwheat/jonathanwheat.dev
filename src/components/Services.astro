---
const services = [
  {number:'01',icon:'/images/icons/web-application.svg',title:'Web Application Development',description:'Custom PHP/Laravel applications, modern JavaScript frontends, APIs, and end-to-end feature delivery.'},
  {number:'02',icon:'/images/icons/mobile-application.svg',title:'Mobile Application Development',description:'Cross-platform iOS and Android applications with React Native, connected to the systems your clients already use.'},
  {number:'03',icon:'/images/icons/legacy-modernization.svg',title:'Legacy Modernization',description:'Debugging, refactoring, upgrades, and thoughtful improvements to established applications and codebases.'},
  {number:'04',icon:'/images/icons/cms-platform.svg',title:'CMS & Platform Development',description:'WordPress, headless CMS, Drupal, custom functionality, and integrations with existing platforms.'},
  {number:'05',icon:'/images/icons/api-integrations.svg',title:'APIs & Integrations',description:'Secure REST APIs, third-party services, data synchronization, authentication, and workflow automation.'},
  {number:'06',icon:'/images/icons/technical-collaboration.svg',title:'Technical Collaboration',description:'Independent delivery or seamless support for your team, from requirements and architecture through testing and deployment.'}
];
---
<section class="section services-section" id="services"><div class="container">
  <div class="section-heading"><div><p class="eyebrow">WHAT I DO</p><h2>Development expertise.<br/><em>Where you need it.</em></h2></div><p>Extra engineering capacity, specialized expertise, or someone to take ownership of a complex project. I can step in and help you deliver.</p></div>
  <div class="service-grid">{services.map(service => <article class="service-card"><div class="service-card-top"><span class="service-icon" aria-hidden="true"><img src={service.icon} alt="" width="34" height="34" loading="lazy" /></span><span class="service-number">{service.number}</span></div><h3>{service.title}</h3><p>{service.description}</p></article>)}</div>
</div></section>
